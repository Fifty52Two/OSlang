static int counter <- 0;

semaphore full <- 0;

process Producer(burst: 3, priority: 1, arrival: 2) {
    counter <- counter + 1;
    post(full);
}

process Consumer(burst: 1, priority: 2, arrival: 0) {
    wait(full);
    counter <- counter - 1;
}

system BlockTest(processes: [Producer, Consumer], scheduler: FCFS);

run(BlockTest);
